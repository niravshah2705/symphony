{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": [
    {
      "target": "app",
      "public": "public",
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**", "sitemap.xml"],
      "rewrites": [
        { "source": "/sitemap.xml", "destination": "/sitemap-platform.xml" },
        { "source": "**", "destination": "/index.html" }
      ],
      "headers": [
        {
          "source": "/",
          "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }]
        },
        {
          "source": "/index.html",
          "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }]
        },
        {
          "source": "/config.js",
          "headers": [{ "key": "Cache-Control", "value": "no-store" }]
        },
        {
          "source": "/googleca0fdd26d71dc36f.html",
          "headers": [{ "key": "Cache-Control", "value": "no-store" }]
        },
        {
          "source": "/adlc/config.js",
          "headers": [{ "key": "Cache-Control", "value": "no-store" }]
        },
        {
          "source": "/adlc/manifest.webmanifest",
          "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
        },
        {
          "source": "/adlc/sw.js",
          "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
        },
        {
          "source": "/adlc/**/*.@(css|js)",
          "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
        },
        {
          "source": "/archagentix/**/*.@(css|js)",
          "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
        },
        {
          "source": "/js/**",
          "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
        },
        {
          "source": "/vendor/**/*.js",
          "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
        },
        {
          "source": "**/*.@(css|json)",
          "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
        },
        {
          "source": "**/*.@(txt|xml)",
          "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
        },
        {
          "source": "/**",
          "headers": [
            { "key": "X-Content-Type-Options", "value": "nosniff" },
            { "key": "X-Frame-Options", "value": "DENY" },
            { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
            { "key": "Strict-Transport-Security", "value": "max-age=31536000" },
            {
              "key": "Content-Security-Policy",
              "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://unpkg.com https://accounts.google.com https://apis.google.com https://www.googletagmanager.com https://sdk.cashfree.com https://checkout.razorpay.com; style-src 'self' 'unsafe-inline' https://unpkg.com https://accounts.google.com https://fonts.googleapis.com; img-src 'self' data: blob: https://api.qrserver.com https://www.google-analytics.com https://www.gstatic.com; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' https://unpkg.com https://*.run.app https://*.googleapis.com wss://*.googleapis.com https://accounts.google.com https://apis.google.com https://securetoken.google.com https://www.google.com https://*.firebaseapp.com https://*.google-analytics.com https://analytics.google.com https://*.cashfree.com https://*.razorpay.com; worker-src 'self' blob:; child-src 'self' blob:; frame-src 'self' https://accounts.google.com https://apis.google.com https://*.firebaseapp.com https://*.cashfree.com https://*.razorpay.com; manifest-src 'self'; media-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self' https://*.cashfree.com; frame-ancestors 'none'; upgrade-insecure-requests"
            }
          ]
        }
      ]
    },
    {
      "target": "www",
      "public": "marketing",
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
      "rewrites": [
        { "source": "/adlc", "destination": "/index.html" },
        { "source": "/adlc/", "destination": "/index.html" },
        { "source": "/adlc/app.js", "destination": "/app.js" },
        { "source": "/adlc/blog", "destination": "/blog/index.html" },
        { "source": "/adlc/blog/", "destination": "/blog/index.html" },
        { "source": "/adlc/blog/evidence", "destination": "/blog/evidence/index.html" },
        { "source": "/adlc/blog/evidence/", "destination": "/blog/evidence/index.html" },
        { "source": "/adlc/blog/getting-started", "destination": "/blog/getting-started/index.html" },
        { "source": "/adlc/blog/getting-started/", "destination": "/blog/getting-started/index.html" },
        { "source": "/adlc/blog/governance", "destination": "/blog/governance/index.html" },
        { "source": "/adlc/blog/governance/", "destination": "/blog/governance/index.html" },
        { "source": "/adlc/blog/integration", "destination": "/blog/integration/index.html" },
        { "source": "/adlc/blog/integration/", "destination": "/blog/integration/index.html" },
        { "source": "/adlc/blog/isolation", "destination": "/blog/isolation/index.html" },
        { "source": "/adlc/blog/isolation/", "destination": "/blog/isolation/index.html" },
        { "source": "/adlc/blog/lifecycle", "destination": "/blog/lifecycle/index.html" },
        { "source": "/adlc/blog/lifecycle/", "destination": "/blog/lifecycle/index.html" },
        { "source": "/adlc/brief", "destination": "/brief/index.html" },
        { "source": "/adlc/brief/", "destination": "/brief/index.html" },
        { "source": "/adlc/config.js", "destination": "/config.js" },
        { "source": "/adlc/field.js", "destination": "/field.js" },
        { "source": "/adlc/manifest.webmanifest", "destination": "/manifest.webmanifest" },
        { "source": "/adlc/media/activity-omnibox.png", "destination": "/media/activity-omnibox.png" },
        { "source": "/adlc/media/adlc-team-card.png", "destination": "/media/adlc-team-card.png" },
        { "source": "/adlc/media/agent-harness-map.png", "destination": "/media/agent-harness-map.png" },
        { "source": "/adlc/media/usage-record.png", "destination": "/media/usage-record.png" },
        { "source": "/adlc/styles.css", "destination": "/styles.css" },
        { "source": "/adlc/sw.js", "destination": "/sw.js" }
      ],
      "headers": [
        {
          "source": "/",
          "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }]
        },
        {
          "source": "/adlc",
          "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }]
        },
        {
          "source": "/adlc/**",
          "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }]
        },
        {
          "source": "/index.html",
          "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }]
        },
        {
          "source": "/config.js",
          "headers": [{ "key": "Cache-Control", "value": "no-store" }]
        },
        {
          "source": "/googleca0fdd26d71dc36f.html",
          "headers": [{ "key": "Cache-Control", "value": "no-store" }]
        },
        {
          "source": "/manifest.webmanifest",
          "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
        },
        {
          "source": "/sw.js",
          "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
        },
        {
          "source": "**/*.@(css|js)",
          "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
        },
        {
          "source": "**/*.@(json)",
          "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
        },
        {
          "source": "**/*.@(txt|xml)",
          "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
        },
        {
          "source": "/**",
          "headers": [
            { "key": "X-Content-Type-Options", "value": "nosniff" },
            { "key": "X-Frame-Options", "value": "DENY" },
            { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
            { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=()" },
            { "key": "Strict-Transport-Security", "value": "max-age=31536000" },
            {
              "key": "Content-Security-Policy",
              "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://unpkg.com https://www.googletagmanager.com; style-src 'self' 'unsafe-inline' https://unpkg.com https://fonts.googleapis.com; img-src 'self' data: blob: https://api.qrserver.com https://www.google-analytics.com; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' https://unpkg.com https://platform.archagentix.com https://fonts.googleapis.com https://*.google-analytics.com https://analytics.google.com; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
            }
          ]
        }
      ]
    },
    {
      "target": "secrets",
      "public": "secrets",
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
      "headers": [
        {
          "source": "/",
          "headers": [
            { "key": "Cache-Control", "value": "no-store" },
            { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
            { "key": "X-Content-Type-Options", "value": "nosniff" },
            { "key": "Referrer-Policy", "value": "no-referrer" }
          ]
        },
        {
          "source": "/config.js",
          "headers": [{ "key": "Cache-Control", "value": "no-store" }]
        },
        {
          "source": "/**",
          "headers": [
            { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
            { "key": "X-Content-Type-Options", "value": "nosniff" },
            { "key": "Referrer-Policy", "value": "no-referrer" },
            { "key": "X-Frame-Options", "value": "DENY" },
            {
              "key": "Content-Security-Policy",
              "value": "default-src 'self'; script-src 'self' https://apis.google.com; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://*.run.app https://*.googleapis.com wss://*.googleapis.com https://accounts.google.com https://apis.google.com https://securetoken.google.com https://www.google.com https://*.firebaseapp.com; frame-src 'self' https://apis.google.com https://*.firebaseapp.com; worker-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
            }
          ]
        },
        {
          "source": "/**/*.@(css|js|mjs)",
          "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
        }
      ]
    }
  ]
}
