{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": [
    {
      "target": "app",
      "public": "public",
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
      "rewrites": [
        { "source": "**", "destination": "/index.html" }
      ],
      "headers": [
        {
          "source": "/",
          "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }]
        },
        {
          "source": "/index.html",
          "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }]
        },
        {
          "source": "/config.js",
          "headers": [{ "key": "Cache-Control", "value": "no-store" }]
        },
        {
          "source": "/adlc/config.js",
          "headers": [{ "key": "Cache-Control", "value": "no-store" }]
        },
        {
          "source": "/adlc/manifest.webmanifest",
          "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
        },
        {
          "source": "/adlc/sw.js",
          "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
        },
        {
          "source": "/adlc/**/*.@(css|js)",
          "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
        },
        {
          "source": "/archagentix/**/*.@(css|js)",
          "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
        },
        {
          "source": "/js/**",
          "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
        },
        {
          "source": "/vendor/**/*.js",
          "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
        },
        {
          "source": "**/*.@(css|json)",
          "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
        },
        {
          "source": "**/*.@(txt|xml)",
          "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
        }
      ]
    },
    {
      "target": "www",
      "public": "marketing",
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
      "rewrites": [
        { "source": "/adlc", "destination": "/index.html" },
        { "source": "/adlc/", "destination": "/index.html" },
        { "source": "/adlc/app.js", "destination": "/app.js" },
        { "source": "/adlc/blog", "destination": "/blog/index.html" },
        { "source": "/adlc/blog/", "destination": "/blog/index.html" },
        { "source": "/adlc/blog/evidence", "destination": "/blog/evidence/index.html" },
        { "source": "/adlc/blog/evidence/", "destination": "/blog/evidence/index.html" },
        { "source": "/adlc/blog/getting-started", "destination": "/blog/getting-started/index.html" },
        { "source": "/adlc/blog/getting-started/", "destination": "/blog/getting-started/index.html" },
        { "source": "/adlc/blog/governance", "destination": "/blog/governance/index.html" },
        { "source": "/adlc/blog/governance/", "destination": "/blog/governance/index.html" },
        { "source": "/adlc/blog/integration", "destination": "/blog/integration/index.html" },
        { "source": "/adlc/blog/integration/", "destination": "/blog/integration/index.html" },
        { "source": "/adlc/blog/isolation", "destination": "/blog/isolation/index.html" },
        { "source": "/adlc/blog/isolation/", "destination": "/blog/isolation/index.html" },
        { "source": "/adlc/blog/lifecycle", "destination": "/blog/lifecycle/index.html" },
        { "source": "/adlc/blog/lifecycle/", "destination": "/blog/lifecycle/index.html" },
        { "source": "/adlc/brief", "destination": "/brief/index.html" },
        { "source": "/adlc/brief/", "destination": "/brief/index.html" },
        { "source": "/adlc/config.js", "destination": "/config.js" },
        { "source": "/adlc/manifest.webmanifest", "destination": "/manifest.webmanifest" },
        { "source": "/adlc/styles.css", "destination": "/styles.css" },
        { "source": "/adlc/sw.js", "destination": "/sw.js" }
      ],
      "headers": [
        {
          "source": "/",
          "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }]
        },
        {
          "source": "/adlc",
          "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }]
        },
        {
          "source": "/adlc/**",
          "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }]
        },
        {
          "source": "/index.html",
          "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }]
        },
        {
          "source": "/config.js",
          "headers": [{ "key": "Cache-Control", "value": "no-store" }]
        },
        {
          "source": "/manifest.webmanifest",
          "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
        },
        {
          "source": "/sw.js",
          "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
        },
        {
          "source": "**/*.@(css|js)",
          "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
        },
        {
          "source": "**/*.@(json)",
          "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
        },
        {
          "source": "**/*.@(txt|xml)",
          "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
        }
      ]
    },
    {
      "target": "secrets",
      "public": "secrets",
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
      "headers": [
        {
          "source": "/",
          "headers": [
            { "key": "Cache-Control", "value": "no-store" },
            { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
            { "key": "X-Content-Type-Options", "value": "nosniff" },
            { "key": "Referrer-Policy", "value": "no-referrer" }
          ]
        },
        {
          "source": "/config.js",
          "headers": [{ "key": "Cache-Control", "value": "no-store" }]
        },
        {
          "source": "/**",
          "headers": [
            { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
            { "key": "X-Content-Type-Options", "value": "nosniff" },
            { "key": "Referrer-Policy", "value": "no-referrer" }
          ]
        },
        {
          "source": "/**/*.@(css|js|mjs)",
          "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
        }
      ]
    }
  ]
}
