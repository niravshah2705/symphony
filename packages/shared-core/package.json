{
  "name": "@ai-fleet/shared-core",
  "version": "1.0.0",
  "description": "Lightweight AI Fleet primitives with NO LLM / agent-SDK dependencies: config, egress routes, logger, authz, store, billing, messaging, OAuth token plumbing, and the runtime provisioner. Imported by non-agent services so they never pull in the agent-SDK tree. The heavy @ai-fleet/shared depends on this package and re-exports these paths for backward compatibility.",
  "private": true,
  "exports": {
    "./config": "./src/config.js",
    "./egress": "./src/egress.js",
    "./logger": "./src/logger.js",
    "./util": "./src/util.js",
    "./authz": "./src/authz.js",
    "./store": "./src/store.js",
    "./store/*": "./src/store/*.js",
    "./pipeline/*": "./src/pipeline/*.js",
    "./agent/*": "./src/agent/*.js",
    "./agent/harness-catalog.json": "./src/agent/harness-catalog.json",
    "./attachments/*": "./src/attachments/*.js",
    "./messaging/*": "./src/messaging/*.js",
    "./billing/*": "./src/billing/*.js",
    "./provisioning": "./src/provisioning/index.js",
    "./provisioning/*": "./src/provisioning/*.js"
  },
  "scripts": {
    "test": "node --test"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@google-cloud/firestore": "^8.7.1",
    "@google-cloud/pubsub": "^6.0.0",
    "@google-cloud/run": "^4.0.0",
    "@google-cloud/scheduler": "^6.0.0",
    "@google-cloud/storage": "^8.0.1",
    "google-auth-library": "^11.0.1",
    "mammoth": "^1.12.1",
    "pdf-parse": "^2.4.5"
  }
}
