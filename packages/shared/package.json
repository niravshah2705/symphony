{
  "name": "@ai-fleet/shared",
  "version": "1.0.0",
  "description": "Shared AI Fleet library: config, JSON store, Linear client, and the deep-agent runtime (framework, tools, skills, LLM router, planner + coder modules). The single source of truth imported by every service — no code is copied per service.",
  "private": true,
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./config": "./src/config.js",
    "./store": "./src/store.js",
    "./linear": "./src/linear.js",
    "./logger": "./src/logger.js",
    "./util": "./src/util.js",
    "./agent/*": "./src/agent/*.js"
  },
  "scripts": {
    "test": "node --test"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@langchain/anthropic": "^1.5.1",
    "@langchain/core": "^1.2.1",
    "@langchain/langgraph": "^1.4.7",
    "@langchain/langgraph-sdk": "^1.9.25",
    "@langchain/ollama": "^1.3.0",
    "@langchain/openai": "^1.5.3",
    "deepagents": "^1.10.5",
    "langsmith": "^0.7.14"
  }
}
