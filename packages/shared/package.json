{
  "name": "@ai-fleet/shared",
  "version": "1.0.0",
  "description": "Shared AI Fleet library: config, JSON store, Linear client, and the deep-agent runtime (framework, tools, skills, LLM router, planner + coder modules). The single source of truth imported by every service — no code is copied per service.",
  "private": true,
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./config": "./src/config.js",
    "./store": "./src/store.js",
    "./linear": "./src/linear.js",
    "./logger": "./src/logger.js",
    "./util": "./src/util.js",
    "./agent/*": "./src/agent/*.js"
  },
  "scripts": {
    "test": "node --test"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.220",
    "@langchain/anthropic": "^1.5.2",
    "@langchain/core": "^1.2.3",
    "@langchain/langgraph": "^1.4.8",
    "@langchain/langgraph-checkpoint": "^1.1.3",
    "@langchain/langgraph-sdk": "^1.9.28",
    "@langchain/ollama": "^1.3.0",
    "@langchain/openai": "^1.5.5",
    "@openai/codex-sdk": "^0.146.0",
    "deepagents": "^1.12.0",
    "langchain": "^1.5.4",
    "langsmith": "^0.7.17"
  }
}
