{
  "name": "ai-fleet",
  "version": "1.0.0",
  "description": "AI Fleet — a microservice-decomposed tool to manage Linear projects and run isolated planner + coder deep-agent services over a shared library.",
  "private": true,
  "license": "SEE LICENSE IN EULA.md",
  "type": "commonjs",
  "workspaces": [
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "start": "node --env-file-if-exists=.env scripts/start-all.js",
    "dev": "node --env-file-if-exists=.env scripts/start-all.js --watch",
    "start:gateway": "npm start -w @ai-fleet/gateway",
    "start:planner": "npm start -w @ai-fleet/planner",
    "start:coder": "npm start -w @ai-fleet/coder",
    "start:tester": "npm start -w @ai-fleet/tester",
    "start:deployer": "npm start -w @ai-fleet/deployer",
    "start:orchestrator": "npm start -w @ai-fleet/orchestrator",
    "start:email": "npm start -w @ai-fleet/email",
    "adlc": "node --env-file-if-exists=.env packages/cli/bin/adlc.js",
    "test": "node --test",
    "checks": "bash scripts/run-checks.sh",
    "test:e2e": "playwright test",
    "test:e2e:debug": "PWDEBUG=1 playwright test --project=chrome",
    "cli:release": "bash scripts/release-cli.sh",
    "gcp:deploy": "bash deploy/gcp/deploy.sh",
    "skills:publish": "bash scripts/publish-skills.sh",
    "registry:publish": "bash scripts/sync-harness-registry.sh",
    "docs:code": "bash scripts/gen-code-docs.sh",
    "docs:agents": "bash scripts/link-agent-docs.sh",
    "graph:build": "bash scripts/build-graphs.sh",
    "registry:build": "node scripts/build-harness-registry.js",
    "spa:obfuscate": "node scripts/obfuscate-spa.js",
    "hooks:install": "git config core.hooksPath .githooks && echo 'Git hooks enabled (core.hooksPath=.githooks)'"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "javascript-obfuscator": "^4.2.2"
  },
  "overrides": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "fast-uri": "^3.1.5"
  },
  "engines": {
    "node": ">=22"
  }
}
