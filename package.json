{
  "name": "ai-fleet",
  "version": "1.0.0",
  "description": "AI Fleet — a microservice-decomposed tool to manage Linear projects and run isolated planner + coder deep-agent services over a shared library.",
  "private": true,
  "license": "SEE LICENSE IN EULA.md",
  "type": "commonjs",
  "workspaces": [
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "start": "node --env-file-if-exists=.env scripts/start-all.js",
    "dev": "node --env-file-if-exists=.env scripts/start-all.js --watch",
    "start:gateway": "npm start -w @ai-fleet/gateway",
    "start:planner": "npm start -w @ai-fleet/planner",
    "start:coder": "npm start -w @ai-fleet/coder",
    "start:tester": "npm start -w @ai-fleet/tester",
    "start:deployer": "npm start -w @ai-fleet/deployer",
    "start:orchestrator": "npm start -w @ai-fleet/orchestrator",
    "start:email": "npm start -w @ai-fleet/email",
    "start:billing": "npm start -w @ai-fleet/billing",
    "adlc": "node --env-file-if-exists=.env packages/cli/bin/adlc.js",
    "test": "node --test",
    "test:secrets": "node --test \"secrets/*.test.mjs\"",
    "test:e2e": "playwright test",
    "test:e2e:debug": "PWDEBUG=1 playwright test --project=chrome",
    "e2e:qa:audit": "node e2e-live/scripts/audit.js",
    "e2e:auth:capture": "node e2e-live/scripts/capture-auth.js",
    "test:e2e:live": "playwright test --config=playwright.live.config.js",
    "docs:code": "bash scripts/gen-code-docs.sh",
    "docs:agents": "bash scripts/link-agent-docs.sh",
    "graph:build": "bash scripts/build-graphs.sh",
    "registry:build": "node scripts/build-harness-registry.js",
    "benchmarks:seed": "node scripts/seed-benchmarks.js",
    "benchmarks:check": "node scripts/seed-benchmarks.js --check",
    "observability:inputs": "node scripts/gen-observability-inputs.js",
    "observability:inputs:check": "node scripts/gen-observability-inputs.js --check",
    "billing:reconcile": "node --env-file-if-exists=.env services/billing/src/reconcile-gateway-spend.js",
    "billing:metrics:check": "bash scripts/kind-metrics-install.sh",
    "billing:metrics:probe": "bash scripts/kind-otel-roundtrip.sh",
    "billing:flexprice:bootstrap": "node scripts/flexprice-bootstrap.js",
    "billing:flexprice:spike": "node scripts/flexprice-spike/run.js",
    "billing:flexprice:provision": "node scripts/flexprice-provision.js",
    "billing:flexprice:phase1-probes": "node scripts/flexprice-phase1-probes.js",
    "billing:recharge:verify": "node scripts/flexprice-recharge-verify.js",
    "billing:flexprice:down": "docker compose -f deploy/flexprice/compose.yaml down -v",
    "billing:flexprice:inspect": "node scripts/flexprice-inspect.js",
    "spa:obfuscate": "node scripts/obfuscate-spa.js",
    "hooks:install": "git config core.hooksPath .githooks && echo 'Git hooks enabled (core.hooksPath=.githooks)'"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "javascript-obfuscator": "^4.2.2"
  },
  "overrides": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "fast-uri": "^3.1.5"
  },
  "engines": {
    "node": ">=22"
  }
}
