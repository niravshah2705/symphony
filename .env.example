# Local development remains a trusted, single-user workflow.
AUTH_MODE=disabled

# Optional default for the OMLX local provider. The Settings page accepts either
# this origin or the equivalent http://127.0.0.1:8000/v1 API base.
# OMLX_HOST=http://127.0.0.1:8000

# Production Firebase Google-SSO example. Uncomment these values in the deployed
# gateway environment. The Firebase web config (apiKey/authDomain/projectId) is
# PUBLIC — the SPA fetches it at runtime from the gateway's /api/auth/config, so
# these are plain env vars, NOT secrets.
# NODE_ENV=production
# AUTH_MODE=firebase
# FIREBASE_PROJECT_ID=              # defaults to GCP_PROJECT_ID when empty
# FIREBASE_API_KEY=                 # public Firebase Web API key (not a secret)
# FIREBASE_AUTH_DOMAIN=             # optional; defaults to <projectId>.firebaseapp.com
# FIREBASE_ALLOWED_DOMAIN=          # optional; empty = any verified user (Google OR Microsoft)
# --- Sign-in providers (which buttons the SPA shows) ---
# Both federate into the same Firebase session, so enable each provider in the
# Firebase console first (Microsoft also needs an Azure app id + secret there —
# the secret NEVER goes in these env vars). Google shows first when both are on.
# AUTH_GOOGLE_ENABLED=true          # default true; set false to hide the Google button
# AUTH_MICROSOFT_ENABLED=false      # set true to show "Continue with Microsoft"
# MICROSOFT_TENANT=                 # optional Azure tenant: 'common' (default, any account),
#                                   # 'organizations' (work/school only), or a tenant id.
#                                   # A tenant id is PUBLIC, not a secret. Alias: AZURE_TENANT_ID
# --- Roles / access (RBAC) ---
# AUTH_ADMIN_EMAILS=                # comma-separated emails granted admin at sign-in (bootstrap)
# AUTH_DEFAULT_ROLE=viewer          # role for a signed-in user with no role claim yet (admin|operator|viewer)
# Other roles are set as a Firebase custom claim: node services/gateway/scripts/set-user-role.js <email> <role>
# Unauthenticated visitors get a read-only Agent workspace; everything else needs a role.

# --- GCP Cloud Run (no-cost) deployment profile ---------------------------
# All optional and INERT locally (defaults keep the file store, in-process
# request delivery, and in-memory event bus, so `npm start` needs no GCP).
# Set these in the deployed services. See docs/GCP_DEPLOY.md.
#
# NODE_ENV=production
# AUTH_MODE=firebase                 # gateway verifies the Firebase ID token
# STORE_BACKEND=firestore            # shared state in Firestore (not data/store.json)
# MESSAGING_MODE=pubsub              # planner/coder requests via Cloud Pub/Sub
# EVENTS_BACKEND=firestore           # SSE fed by Firestore onSnapshot (multi-instance)
# GCP_PROJECT_ID=your-gcp-project
# GCP_REGION=asia-south1
# PUBSUB_PLANNER_TOPIC=planner-requests
# PUBSUB_CODER_TOPIC=coder-requests
# CODER_JOB_NAME=coder-worker
# PUBSUB_PUSH_AUDIENCE=https://<service-url>     # expected aud of push OIDC tokens
# PUBSUB_PUSH_SA=pubsub-push@<project>.iam.gserviceaccount.com
# CODER_ROLE=control                 # coder-worker Job overrides this to 'worker'
# AI_FLEET_DATA_DIR=/tmp             # logs only; state lives in Firestore
#
# Gateway-only:
# SPA_ORIGIN=https://storage.googleapis.com/<bucket>   # CORS allowlist for the GCS SPA
# API_BASE_URL=https://<gateway-url>                    # injected into the SPA's config.js
# STREAM_TOKEN_SECRET=...            # from Secret Manager; signs SSE stream tokens
#
# Secrets (from Secret Manager, injected as env; override the stored settings):
# LINEAR_API_KEY=...
# GITHUB_TOKEN=...
# LANGSMITH_API_KEY=...
#
# Egress proxy sidecar (planner/coder/worker only — NOT the gateway). When set,
# the agent routes all third-party calls through the co-located proxy, which
# injects the real credential, so the agent holds no raw provider key.
# EGRESS_PROXY_URL=http://127.0.0.1:4030
# PROXY_PORT=4030
# PROXY_ORG_ID=<org-uuid>            # per-tenant stack only (scopes the vault)
#
# Also route the native SDK runtimes (codex-sdk/claude-agent-sdk/antigravity) and
# LangSmith tracing through the proxy. Off by default (deep-agent runtime is
# proxied unconditionally). Only meaningful when EGRESS_PROXY_URL is set.
# EGRESS_PROXY_INCLUDE_SDK=true
#
# Shared internal S2S token — verifies the provisioner write-back AND the proxy's
# secret resolve against the settings service (constant-time compare).
# INTERNAL_API_TOKEN=...
#
# --- Billing / cost metering (all optional; INERT unless enabled) -------------
# First-party LLM usage metering + a per-org credit ledger, a periodic sweep that
# turns usage into line items, threshold notifications, (simulated) auto-recharge,
# and a negative-balance runner pause. Money is handled in integer paise.
# BILLING_SWEEP_ENABLED=true          # master switch: the 5-min sweep + balance gate
# USD_TO_INR=87                       # approximate FX applied to third-party LLM cost
# INITIAL_CREDIT_INR=500              # starting credit seeded once per org account
# BILLING_USAGE_RETENTION_DAYS=90     # keep granular usage records this long
# FLEET_ORG_ID=<org-uuid>             # the org this deployment bills to (dedicated
#                                     # stacks; falls back to PROXY_ORG_ID). Empty on
#                                     # the shared stack ⇒ a shared free-tier account.
# Notification channels (browser is always on via SSE — no secret). Email/Slack are
# OPTIONAL and read from env; set them only on a NON-proxied service (agent
# containers must not hold raw secrets — prefer the settings vault in production).
# BILLING_SMTP_URL=smtp://user:pass@host:587   # email alerts (requires `npm i nodemailer`)
# BILLING_EMAIL_FROM=ai-fleet@example.com
# BILLING_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
#
# --- Settings service (the single managed-key + per-org vault source) ---------
# Per-org secret vault encryption. Unset ⇒ in-memory KMS fake (local/dev); set to
# a Cloud KMS crypto-key resource for real AES-256-GCM envelope encryption.
# KMS_KEY_NAME=projects/<p>/locations/<l>/keyRings/aifleet-secrets/cryptoKeys/org-secrets
#
# Platform-managed provider keys are mounted on the SETTINGS service (not the
# proxy): the settings resolver returns them for a 'managed' selection so managed
# and customer keys share ONE resolution path. These are the same names the
# store.js env overlay uses for the non-proxied gateway.
# GEMINI_API_KEY=...
# HUGGINGFACE_API_KEY=...
# ANTHROPIC_API_KEY=...
# OPENAI_API_KEY=...
