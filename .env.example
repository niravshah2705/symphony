# Local development remains a trusted, single-user workflow.
AUTH_MODE=disabled

# Optional default for the OMLX local provider. The Settings page accepts either
# this origin or the equivalent http://127.0.0.1:8000/v1 API base.
# OMLX_HOST=http://127.0.0.1:8000
# In proxied/cloud mode only the proxy accepts a trusted oMLX target. Keep this
# to a path-free operator-controlled origin; browser settings cannot override it.
# OMLX_PROXY_UPSTREAM=http://omlx.internal:8000
# OLLAMA_PROXY_UPSTREAM=http://ollama.internal:11434
# LMSTUDIO_PROXY_UPSTREAM=http://lmstudio.internal:1234
# OPENSWE_PROXY_UPSTREAM=http://openswe.internal:2024

# Production Firebase Google-SSO example. Uncomment these values in the deployed
# gateway environment. The Firebase web config (apiKey/authDomain/projectId) is
# PUBLIC — the SPA fetches it at runtime from the gateway's /api/auth/config, so
# these are plain env vars, NOT secrets.
# NODE_ENV=production
# AUTH_MODE=firebase
# FIREBASE_PROJECT_ID=              # defaults to GCP_PROJECT_ID when empty
# FIREBASE_API_KEY=                 # public Firebase Web API key (not a secret)
# FIREBASE_AUTH_DOMAIN=             # optional; defaults to <projectId>.firebaseapp.com
# FIREBASE_ALLOWED_DOMAIN=          # optional; empty = any verified user (Google OR Microsoft)
# --- Sign-in providers (which buttons the SPA shows) ---
# Both federate into the same Firebase session, so enable each provider in the
# Firebase console first (Microsoft also needs an Azure app id + secret there —
# the secret NEVER goes in these env vars). Google shows first when both are on.
# AUTH_GOOGLE_ENABLED=true          # default true; set false to hide the Google button
# AUTH_MICROSOFT_ENABLED=false      # set true to show "Continue with Microsoft"
# MICROSOFT_TENANT=                 # optional Azure tenant: 'common' (default, any account),
#                                   # 'organizations' (work/school only), or a tenant id.
#                                   # A tenant id is PUBLIC, not a secret. Alias: AZURE_TENANT_ID
# --- Roles / access (RBAC) ---
# AUTH_ADMIN_EMAILS=                # comma-separated emails granted admin at sign-in (bootstrap)
# AUTH_DEFAULT_ROLE=viewer          # role for a signed-in user with no role claim yet (admin|operator|viewer)
# Other roles are set as a Firebase custom claim: node services/gateway/scripts/set-user-role.js <email> <role>
# Unauthenticated visitors get a read-only Agent workspace; everything else needs a role.

# --- GCP Cloud Run (no-cost) deployment profile ---------------------------
# All optional and INERT locally (defaults keep the file store, in-process
# request delivery, and in-memory event bus, so `npm start` needs no GCP).
# Set these in the deployed services. See docs/GCP_DEPLOY.md.
#
# NODE_ENV=production
# AUTH_MODE=firebase                 # gateway verifies the Firebase ID token
# STORE_BACKEND=firestore            # shared state in Firestore (not data/store.json)
# MESSAGING_MODE=pubsub              # control-plane requests via Cloud Pub/Sub
# EVENTS_BACKEND=firestore           # SSE fed by Firestore onSnapshot (multi-instance)
# PIPELINE_ORCHESTRATOR_ENABLED=false # safe rollout; true switches off legacy label auto-chaining
# PIPELINE_DEPLOYMENT_ENABLED=false   # separate fail-closed deployment gate
# PIPELINE_REQUIRE_DEPLOYMENT_APPROVAL=true # required for production deploys
# GCP_PROJECT_ID=your-gcp-project
# GCP_REGION=asia-south1
# PUBSUB_PLANNER_TOPIC=planner-requests
# PUBSUB_CODER_TOPIC=coder-requests
# PUBSUB_PIPELINE_PLAN_TOPIC=pipeline-plan-commands
# PUBSUB_PIPELINE_CODE_TOPIC=pipeline-code-commands
# PUBSUB_PIPELINE_TEST_TOPIC=pipeline-test-commands
# PUBSUB_PIPELINE_DEPLOY_TOPIC=pipeline-deploy-commands
# PUBSUB_PIPELINE_PLAN_RESULTS_TOPIC=pipeline-plan-results
# PUBSUB_PIPELINE_CODE_RESULTS_TOPIC=pipeline-code-results
# PUBSUB_PIPELINE_TEST_RESULTS_TOPIC=pipeline-test-results
# PUBSUB_PIPELINE_DEPLOY_RESULTS_TOPIC=pipeline-deploy-results
# PIPELINE_STAGE_STORE_BACKEND=firestore # required on production stage workers
# ORCHESTRATOR_URL=http://localhost:4070
# TESTER_URL=http://localhost:4050
# DEPLOYER_URL=http://localhost:4060
# INTERNAL_API_TOKEN=...             # mandatory for direct pipeline stage ingress
# CODER_JOB_NAME=coder-worker
# PUBSUB_PUSH_AUDIENCE=https://<service-url>     # expected aud of push OIDC tokens
# PUBSUB_PUSH_SA=pubsub-push@<project>.iam.gserviceaccount.com
# CODER_ROLE=control                 # coder-worker Job overrides this to 'worker'
# AI_FLEET_DATA_DIR=/tmp             # logs only; state lives in Firestore
#
# Gateway-only:
# SPA_ORIGIN=https://storage.googleapis.com/<bucket>   # CORS allowlist for the GCS SPA
# API_BASE_URL=https://<gateway-url>                    # injected into the SPA's config.js
# STREAM_TOKEN_SERVICE_URL=https://<stream-token-broker-url> # mandatory shared broker; HTTPS outside loopback
#
# Standalone local stream-token broker (`npm start` / Compose) only:
# LOCAL_STREAM_TOKEN_PORT=4031                          # optional `npm start` broker port
# STREAM_TOKEN_SECRET=...                               # broker/Compose only; never set on a gateway
#
# Public SPA deploy setting (read by deploy tooling, not a secret). Empty/unset
# leaves analytics disabled, including for local development and automated tests.
# GOOGLE_ANALYTICS_MEASUREMENT_ID=G-XXXXXXXXXX
#
# Managed secrets (mounted on the settings service only; never add provider
# credentials to gateway or agent app containers). Linear credentials are
# customer-owned and stored through the per-organization/project encrypted vault.
# GITHUB_TOKEN=...
# LANGSMITH_API_KEY=...
#
# Egress proxy sidecar (planner/coder/worker/tester/deployer only — NOT the gateway
# or orchestrator). It is mandatory in deployed agent runtimes. When set,
# the agent routes all third-party calls through the co-located proxy, which
# injects the real credential, so the agent holds no raw provider key.
# EGRESS_PROXY_URL=http://127.0.0.1:4030
# PROXY_PORT=4030
# PROXY_CAPABILITIES=egress
# PROXY_ORG_ID=<org-uuid>            # per-tenant stack only (scopes the vault)
# ORG_INTERNAL_API_TOKEN=...         # provisioner-derived bearer bound to PROXY_ORG_ID
#
# Native SDK runtimes and LangSmith follow the proxy automatically; there is no
# direct-egress opt-out once EGRESS_PROXY_URL is present.
#
# Shared internal S2S token — verifies shared control-plane operations and the
# managed-only proxy resolve. Tenant vault reads use ORG_INTERNAL_API_TOKEN.
# INTERNAL_API_TOKEN=...
# ORG_S2S_SIGNING_KEY=...            # settings + provisioner only; never agents/proxies
#
# --- Shared transactional email service (optional locally) -------------------
# The email service is shared control-plane infrastructure; it is never cloned
# into per-tenant agent stacks. It accepts only allow-listed Pub/Sub templates.
# EMAIL_SERVICE_PORT=4040
# EMAIL_URL=http://localhost:4040       # local direct-mode producer target
# EMAIL_TOPIC=email-delivery            # Pub/Sub topic in cloud mode
# EMAIL_SMTP_HOST=smtp.example.com
# EMAIL_SMTP_PORT=587
# EMAIL_SMTP_SECURE=false             # true for implicit TLS (normally port 465)
# EMAIL_SMTP_REQUIRE_TLS=true         # require STARTTLS when secure=false
# EMAIL_SMTP_USER=...
# EMAIL_SMTP_PASSWORD=...
# EMAIL_FROM=AI Fleet <noreply@example.com>
# PUBLIC_APP_URL=http://localhost:4000
#
# --- Billing / cost metering (all optional; INERT unless enabled) -------------
# First-party LLM usage metering + a per-org credit ledger, a periodic sweep that
# turns usage into line items, threshold notifications, (simulated) auto-recharge,
# and a negative-balance runner pause. Money is handled in integer paise.
# BILLING_SWEEP_ENABLED=true          # master switch: the 5-min sweep + balance gate
# USD_TO_INR=87                       # approximate FX applied to third-party LLM cost
# INITIAL_CREDIT_INR=500              # starting credit seeded once per org account
# BILLING_USAGE_RETENTION_DAYS=90     # keep granular usage records this long
# FLEET_ORG_ID=<org-uuid>             # the org this deployment bills to (dedicated
#                                     # stacks; falls back to PROXY_ORG_ID). Empty on
#                                     # the shared stack ⇒ a shared free-tier account.
# Notification channels (browser is always on via SSE — no secret). Email jobs
# go through EMAIL_TOPIC/the shared email service, so agent containers never
# receive SMTP credentials. In proxy mode the Slack webhook URL belongs in the
# encrypted organization/project vault; this env is local direct-mode only.
# BILLING_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
#
# --- Settings service (the single managed-key + per-org vault source) ---------
# Per-org secret vault encryption. Unset ⇒ in-memory KMS fake (local/dev); set to
# a Cloud KMS crypto-key resource for real AES-256-GCM envelope encryption.
# KMS_KEY_NAME=projects/<p>/locations/<l>/keyRings/aifleet-secrets/cryptoKeys/org-secrets
#
# Platform-managed provider keys are mounted on the SETTINGS service (not the
# proxy): the settings resolver returns them for a 'managed' selection so managed
# and customer keys share ONE resolution path. Local direct mode may still use
# the legacy settings overlay; deployed gateway/agent containers receive none.
# A managed hosted-LLM selection is ready only when its matching key has an
# enabled Secret Manager version and is present in `managed_provider_secrets`:
# Gemini/Antigravity = GEMINI_API_KEY, Hugging Face = HUGGINGFACE_API_KEY,
# Claude = ANTHROPIC_API_KEY, and OpenAI/Codex API-key mode = OPENAI_API_KEY.
# CODEX_BACKEND=chatgpt instead requires an org-scoped imported Codex token
# bundle; use CODEX_BACKEND=api for OPENAI_API_KEY.
# Customer selections require a dedicated stack pinned by FLEET_ORG_ID (the
# proxy sidecar is pinned by PROXY_ORG_ID); shared-stack pipeline admission
# rejects them because a shared proxy cannot safely choose an organization.
# GEMINI_API_KEY=...
# HUGGINGFACE_API_KEY=...
# ANTHROPIC_API_KEY=...
# OPENAI_API_KEY=...
