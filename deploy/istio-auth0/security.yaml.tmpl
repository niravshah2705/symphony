apiVersion: security.istio.io/v1
kind: RequestAuthentication
metadata:
  name: ai-fleet-auth0
  namespace: ${AI_FLEET_NAMESPACE}
spec:
  selector:
    matchLabels:
      app.kubernetes.io/name: ai-fleet-gateway
  jwtRules:
    - issuer: "https://${AUTH0_DOMAIN}/"
      jwksUri: "https://${AUTH0_DOMAIN}/.well-known/jwks.json"
      audiences:
        - "${AUTH0_AUDIENCE}"
      # The access token is consumed by Envoy. The application receives the
      # verified base64-encoded JSON payload, not the bearer credential.
      forwardOriginalToken: false
      outputPayloadToHeader: x-ai-fleet-jwt-payload
---
apiVersion: security.istio.io/v1
kind: AuthorizationPolicy
metadata:
  name: ai-fleet-require-auth0
  namespace: ${AI_FLEET_NAMESPACE}
spec:
  selector:
    matchLabels:
      app.kubernetes.io/name: ai-fleet-gateway
  action: ALLOW
  rules:
    # The browser must load the SPA before it can begin Universal Login. The
    # application has no non-API mutation routes, so limit this to GET/HEAD.
    - to:
        - operation:
            methods:
              - GET
              - HEAD
            notPaths:
              - /api
              - /api/*
    # Public bootstrap/readiness endpoints.
    - to:
        - operation:
            methods:
              - GET
              - HEAD
            paths:
              - /api/auth/config
              - /healthz
    # A browser may send a CORS preflight without credentials. The actual API
    # request still has to match the authenticated rule below.
    - to:
        - operation:
            methods:
              - OPTIONS
            paths:
              - /api
              - /api/*
    # RequestAuthentication validates the signature, expiry, and audience.
    # Requiring both a principal and the exact issuer fails closed if another
    # JWT provider is added to this workload later.
    - from:
        - source:
            requestPrincipals:
              - "*"
      to:
        - operation:
            paths:
              - /api
              - /api/*
      when:
        - key: request.auth.claims[iss]
          values:
            - "https://${AUTH0_DOMAIN}/"
        - key: request.auth.claims[permissions]
          values:
            - "${AUTH0_REQUIRED_PERMISSION}"
