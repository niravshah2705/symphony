# Written by scripts/flexprice-bootstrap.js — copy to .env only if you are
# debugging the compose file by hand. Values here are placeholders, not usable
# secrets: FLEXPRICE_ALLOW_INSECURE_DEFAULTS=true is what upstream's compose ships
# with, and it bypasses the two boot checks that exist to reject the public dev key.
# The real .env is gitignored and generated with the flag at false.

# Path to the FlexPrice checkout pinned in ../VERSION. The image is built from it;
# ghcr.io/flexprice/flexprice is a private package and cannot be pulled.
FLEXPRICE_CHECKOUT=/tmp/fp-checkout

# Databases. Both role names must be `flexprice`: migrations/postgres/
# init-temporal-db.sh runs `GRANT ... TO flexprice` with the name hardcoded, so
# anything else fails first boot with postgres exit 3 and an error that points at
# postgres rather than at the name. Passwords are hex for the same kind of reason
# — ClickHouse's entrypoint passes $CLICKHOUSE_PASSWORD to clickhouse-client
# unquoted, so a leading `-` is parsed as a CLI flag and the container dies.
FLEXPRICE_PG_USER=flexprice
FLEXPRICE_PG_PASSWORD=change-me-hex
FLEXPRICE_PG_DB=flexprice
FLEXPRICE_CH_USER=flexprice
FLEXPRICE_CH_PASSWORD=change-me-hex
FLEXPRICE_CH_DB=flexprice

# Secrets validated at boot unless FLEXPRICE_DEPLOYMENT_MODE=local
FLEXPRICE_AUTH_SECRET=change-me-64-hex
FLEXPRICE_SECRETS_ENCRYPTION_KEY=change-me-64-hex
FLEXPRICE_ALLOW_INSECURE_DEFAULTS=false

# Raw key for our own client; the API is given only its sha256, inside the JSON map.
FLEXPRICE_API_KEY=fp_local_change-me
FLEXPRICE_AUTH_API_KEY_KEYS={"<sha256-of-raw-key>":{"tenant_id":"00000000-0000-0000-0000-000000000000","user_id":"00000000-0000-0000-0000-000000000000","name":"AI Fleet Phase 0 local","is_active":true}}
