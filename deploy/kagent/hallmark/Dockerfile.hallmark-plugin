# Agent Plugins 1.0.0 bundle for the hallmark row of ../plugins.csv.
#
# Data only: Substrate mounts this image read-only and kagent reads plugin.json
# and skills/ out of it, so there is nothing to run and no base layer to carry.
# A pack's software requirement therefore belongs in the harness runtime image
# (go/harness/<cli>/Dockerfile), never here.
FROM scratch

COPY bundle/. /

LABEL org.opencontainers.image.title="hallmark-plugin" \
      org.opencontainers.image.description="kagent plugin bundle: hallmark skills, repackaged from upstream at a pinned commit" \
      org.opencontainers.image.source="https://github.com/niravshah2705/symphony/tree/main/deploy/kagent/hallmark" \
      org.opencontainers.image.licenses="MIT"
