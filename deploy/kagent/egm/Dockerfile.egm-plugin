# Agent Plugins 1.0.0 bundle for the egm row of ../plugins.csv.
#
# Data only: Substrate mounts this image read-only and kagent reads plugin.json
# and skills/ out of it, so there is nothing to run and no base layer to carry.
# A pack's software requirement therefore belongs in the harness runtime image
# (go/harness/<cli>/Dockerfile), never here.
#
# This bundle also carries agents/, resources/ and three docs/*.md beside
# skills/, because EGM's skills cite them from the plugin root. They are data
# in the same read-only mount; nothing here executes them.
FROM scratch

COPY bundle/. /

LABEL org.opencontainers.image.title="egm-plugin" \
      org.opencontainers.image.description="kagent plugin bundle: Elephant-Goldfish Model skills and their reviewer prompts, repackaged from upstream at a pinned commit" \
      org.opencontainers.image.source="https://github.com/niravshah2705/symphony/tree/main/deploy/kagent/egm" \
      org.opencontainers.image.licenses="Apache-2.0"
