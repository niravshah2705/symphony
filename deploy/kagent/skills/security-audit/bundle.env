# Declarative inputs for the security-audit standalone-skill artifact.
# Sourced by deploy/kagent/build-skill-image.sh and by
# .github/workflows/build-skill-images.yml, so the local and CI composes agree.
#
# cloudflare/security-audit-skill is ONE skill directory and nothing else: no
# plugin.json, no releases, no tags. So there is no allowlist to curate (the
# artifact is the skill) and no version to read (the label is the pin).
SKILL_NAME="security-audit"
SKILL_PATH="skills/security-audit"
# The pack's own unit tests for its two validators. The agent runs the
# validators; it never runs their tests, and 55 KB of fixture is 16% of the
# mount for nothing. SKILL.md itself is not excludable.
SKILL_EXCLUDES="*.test.cjs"
IMAGE_NAME="security-audit-skill"
