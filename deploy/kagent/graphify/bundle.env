# graphify ships graphify/skill.md plus per-harness variants and no skills/
# tree; the skill is authored here, and the MCP server travels as mcp.json.
# shellcheck disable=SC2034
PLUGIN_NAME=graphify
PLUGIN_VERSION_SOURCE=pyproject.toml
PLUGIN_SKILLS_SRC=skills
PLUGIN_SKILLS_LIST=deploy/kagent/graphify/skills.txt
PLUGIN_OVERLAY_DIR=deploy/kagent/graphify/overlay
PLUGIN_MCP_FILE=deploy/kagent/graphify/mcp.json
PLUGIN_DESCRIPTION="Graphify codebase knowledge graph, packaged for kagent"
