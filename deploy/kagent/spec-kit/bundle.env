# spec-kit ships templates/commands/*.md and no skills/ tree at all, so the one
# skill the bundle carries is authored here and overlaid onto the checkout.
# shellcheck disable=SC2034
PLUGIN_NAME=spec-kit
PLUGIN_VERSION_SOURCE=pyproject.toml
PLUGIN_SKILLS_SRC=skills
PLUGIN_SKILLS_LIST=deploy/kagent/spec-kit/skills.txt
PLUGIN_OVERLAY_DIR=deploy/kagent/spec-kit/overlay
PLUGIN_DESCRIPTION="Spec Kit specification-driven workflow, packaged for kagent"
