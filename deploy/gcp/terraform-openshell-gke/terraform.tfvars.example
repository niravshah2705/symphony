# Copy to terraform.tfvars and adjust. Values here match the live
# openshell-multitenant deployment.

project_id     = "adlc-9e72f"
region         = "asia-south1"
zone           = "asia-south1-a"
cluster_name   = "openshell-multitenant"
node_pool_name = "openshell-multitenant-node-pool"

# VPC & networking
vpc_name            = "default"
subnet_name         = "openshell-subnet"
subnet_primary_cidr = "10.10.0.0/20"
pods_cidr           = "10.20.0.0/14"
services_cidr       = "10.24.0.0/20"

# Domain & certificates
domain     = "openshell.archagentix.com"
cert_email = "you@example.com"

# Component versions (match helm list -A on the live cluster)
openshell_version     = "0.1.5"
cert_manager_version  = "v1.20.3"
envoy_gateway_version = "v1.8.1"

# Tenants
tenants = ["tenant-a", "tenant-b"]

# Tenant node pool — the power workflow parks min_nodes at 0 to stop the
# cluster and restores it to 2 on start.
machine_type = "e2-standard-2"
disk_size_gb = 50
disk_type    = "pd-standard"
min_nodes    = 2
max_nodes    = 8

# System node pool — always on. The agent-sandbox controller, Envoy Gateway,
# cert-manager and the OpenShell gateway are pinned to it by
# nodeSelector cloud.google.com/gke-nodepool, so the tenant pool can drain to
# zero without the autoscaler re-buying a node for a singleton control-plane
# pod. ~1 CPU / 2.3 GiB of requests is what those add-ons actually need.
system_node_pool_name = "openshell-system-node-pool"
system_machine_type   = "e2-standard-2"
system_min_nodes      = 1
system_max_nodes      = 3

# Identity the cluster-power workflow drains tenant nodes with. gh-deployer
# already holds roles/container.admin, which GKE maps to cluster-admin, so the
# ci_rbac.tf binding is optional — set it if you grant a pool-scoped role
# instead. Must match the GCP_DEPLOYER_SA secret exactly.
power_ci_sa_email = "gh-deployer@adlc-9e72f.iam.gserviceaccount.com"

# HARDENING TODO: restrict control-plane access to known CIDRs
master_authorized_networks_cidr = "0.0.0.0/0"
deletion_protection             = true

# ---------------------------------------------------------------------------
# Agent Substrate (optional). Leave substrate_enabled = false to keep the
# OpenShell-only plan unchanged. The ate-system control plane is installed by
# the upstream substrate installer (go run ./cmd/ate-setup deploy ate-system),
# NOT by this config — see docs/SUBSTRATE_INTEGRATION.md. This module only adds
# the dedicated worker pool, credential/snapshot namespaces, PD snapshot storage
# and the public actor ingress that the installer's atenet-router needs.
# ---------------------------------------------------------------------------
substrate_enabled                 = false
substrate_node_pool_name          = "substrate-worker-pool"
substrate_machine_type            = "e2-standard-4"
substrate_min_nodes               = 1
substrate_max_nodes               = 6
substrate_snapshot_storage_class  = "substrate-snapshot-pd"
substrate_credentials_namespace   = "substrate-credentials"
# Public hostname fronting the actor data plane (substrateIngressUrl). When set
# (and substrate_enabled) a cert-manager Certificate + Envoy Gateway + HTTPRoute
# are created pointing at atenet-router; leave empty to skip the ingress.
substrate_ingress_hostname        = ""
