# syntax=docker/dockerfile:1
#
# Egress proxy sidecar image. Runs co-located with planner / coder / coder-worker
# (Cloud Run multi-container, shared loopback) and injects per-org credentials so
# the agent containers hold no raw provider keys.
#
# Build from the MONOREPO ROOT so npm workspaces can resolve @ai-fleet/shared-core:
#   docker build -f deploy/gcp/Dockerfile.proxy -t <tag> .
#
# Base image is pinned by DIGEST (infrastructure-misconfig checklist) — the
# multi-arch index digest for node:22-alpine.
# VERIFY / UPDATE with: docker buildx imagetools inspect node:22-alpine
ARG NODE_IMAGE=node:22-alpine@sha256:c610fcdfb1d5b4740dd70c284ed3cb16bb857e0f7166196e36a5501df7a3aa32

# ---------------------------------------------------------------------------
# Stage 1 — install ONLY the proxy's dependency closure.
# ---------------------------------------------------------------------------
FROM ${NODE_IMAGE} AS builder
WORKDIR /app
ENV NODE_ENV=production

# The proxy depends ONLY on @ai-fleet/shared-core (lightweight primitives —
# config, egress, logger, OAuth-token plumbing, store), NOT on @ai-fleet/shared
# (which drags in the ~600 MB LLM / agent-SDK tree). Copy just those two
# workspaces + the root manifests: `npm ci` then installs only this closure and
# simply skips the absent coder/planner/gateway/shared workspaces, so the heavy
# agent SDKs are NEVER installed — no post-install prune needed, and the install
# stays reproducible from the committed lockfile.
COPY package.json package-lock.json ./
COPY packages/shared-core/ ./packages/shared-core/
COPY services/proxy/ ./services/proxy/

RUN npm ci --omit=dev && npm cache clean --force

# ---------------------------------------------------------------------------
# Stage 2 — minimal runtime.
# ---------------------------------------------------------------------------
FROM ${NODE_IMAGE} AS runtime
WORKDIR /app

ENV NODE_ENV=production \
    AI_FLEET_DATA_DIR=/tmp

COPY --from=builder --chown=node:node /app /app

# Non-root (infra-misconfig checklist).
USER node

# The proxy reads process.env.PROXY_PORT. As a Cloud Run sidecar it binds a
# non-ingress port on the shared loopback (default 4030); the ingress container
# keeps 8080.
EXPOSE 4030

CMD ["node", "services/proxy/src/index.js"]
