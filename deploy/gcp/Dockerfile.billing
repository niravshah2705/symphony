# syntax=docker/dockerfile:1
#
# Billing service image (INTERNAL Cloud Run service).
# Build from the monorepo root so npm workspaces resolve @software-factory/shared-core:
#   docker build -f deploy/gcp/Dockerfile.billing -t <tag> .
#
# Base image is pinned by DIGEST (not just a mutable tag) per the
# infrastructure-misconfig checklist. This is the multi-arch index digest for
# node:22-alpine.
ARG NODE_IMAGE=node:22-alpine@sha256:c610fcdfb1d5b4740dd70c284ed3cb16bb857e0f7166196e36a5501df7a3aa32

FROM ${NODE_IMAGE} AS builder
WORKDIR /app
ENV NODE_ENV=production

# The billing service uses only lightweight shared primitives. Keep the
# agent-oriented @software-factory/shared workspace out of the image so it never pulls
# in agent SDKs or LLM dependencies.
COPY package.json package-lock.json ./
COPY packages/shared-core/package.json ./packages/shared-core/package.json
COPY services/billing/package.json ./services/billing/package.json

RUN npm ci --omit=dev \
      --workspace=@software-factory/shared-core \
      --workspace=@software-factory/billing \
      --include-workspace-root=false \
    && npm cache clean --force

COPY packages/shared-core/ ./packages/shared-core/
COPY services/billing/ ./services/billing/
# The rate card is the author of every debit (see packages/shared-core/src/billing/
# credit-rates.js), and it is loaded once at boot and memoised per process — so shipping
# it is not optional and a rate change is a REDEPLOY, not an edit that takes effect
# mid-traffic. The COPY target, the ENV below and credit-rates.js's default path are one
# contract, held by deploy/billing/credit-rates.test.js.
COPY deploy/billing/credit-rates.yaml ./deploy/billing/credit-rates.yaml

FROM ${NODE_IMAGE} AS runtime
WORKDIR /app

ENV NODE_ENV=production \
    SOFTWARE_FACTORY_DATA_DIR=/tmp \
    CREDIT_RATES_FILE=/app/deploy/billing/credit-rates.yaml

COPY --from=builder --chown=node:node /app /app

USER node

EXPOSE 8080

CMD ["node", "services/billing/src/index.js"]
