# syntax=docker/dockerfile:1
# Durable pipeline control plane.
#
# It carries @software-factory/shared as well as @software-factory/shared-core + LangGraph:
# #283 retired the Cloud Run planner and absorbed its HTTP surface into
# services/orchestrator/src/agent-surface.js, which is mounted from app.js and
# requires the shared library at boot. The image was left packaging only
# shared-core, so the revision died at `Cannot find module
# '@software-factory/shared/agent/pipeline-stage-service'` — a build-time- invisible
# MODULE_NOT_FOUND, because npm ci never resolves local requires.
#
# The credential half of the earlier "never acquire the agent SDK tree or
# provider credentials" rule still holds and is what actually matters: no
# provider key enters this image or its environment. The orchestrator sends the
# egress sentinel and the sidecar / model gateway resolves the real credential,
# so confinement comes from the environment boundary rather than from which
# directories are copied into the image.
ARG NODE_IMAGE=node:22-alpine@sha256:c610fcdfb1d5b4740dd70c284ed3cb16bb857e0f7166196e36a5501df7a3aa32

FROM ${NODE_IMAGE} AS builder
WORKDIR /app
ENV NODE_ENV=production

COPY package.json package-lock.json ./
COPY packages/shared-core/ ./packages/shared-core/
COPY packages/shared/ ./packages/shared/
COPY services/orchestrator/ ./services/orchestrator/
# recordUsage runs HERE too (packages/shared-core/src/billing/usage.js is called by the
# in-process harnesses and by the actor's dispatching planner), so this image needs the
# rate card for the same reason Dockerfile.billing does: no card, no price, and the boot
# gate refuses to start a service that cannot bill the runs it accepts.
COPY deploy/billing/credit-rates.yaml ./deploy/billing/credit-rates.yaml

# @software-factory/shared is selected explicitly: npm only installs the deps of the
# workspaces named here, so leaving it out would resolve the symlink but ship
# the agent library with its own dependency tree missing.
RUN npm ci --omit=dev \
      --workspace=@software-factory/shared-core \
      --workspace=@software-factory/shared \
      --workspace=@software-factory/orchestrator \
      --include-workspace-root=false \
    && npm cache clean --force

FROM ${NODE_IMAGE} AS runtime
WORKDIR /app
ENV NODE_ENV=production \
    SOFTWARE_FACTORY_DATA_DIR=/tmp \
    CREDIT_RATES_FILE=/app/deploy/billing/credit-rates.yaml
COPY --from=builder --chown=node:node /app /app
USER node
EXPOSE 8080
CMD ["node", "services/orchestrator/src/index.js"]
