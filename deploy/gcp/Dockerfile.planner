# syntax=docker/dockerfile:1
#
# Planner service image (INTERNAL Cloud Run service).
#
# Build from the MONOREPO ROOT so npm workspaces can resolve @ai-fleet/shared:
#   docker build -f deploy/gcp/Dockerfile.planner -t <tag> .
#
# Base image is pinned by DIGEST (infrastructure-misconfig checklist) — the
# multi-arch index digest for node:22-alpine.
# VERIFY / UPDATE with: docker buildx imagetools inspect node:22-alpine
ARG NODE_IMAGE=node:22-alpine@sha256:c610fcdfb1d5b4740dd70c284ed3cb16bb857e0f7166196e36a5501df7a3aa32

# ---------------------------------------------------------------------------
# Stage 1 — install production dependencies at the workspace root.
# ---------------------------------------------------------------------------
FROM ${NODE_IMAGE} AS builder
WORKDIR /app
ENV NODE_ENV=production

COPY package.json package-lock.json ./
COPY packages/ ./packages/
COPY services/ ./services/

RUN npm ci --omit=dev && npm cache clean --force

# ---------------------------------------------------------------------------
# Stage 2 — minimal runtime.
# ---------------------------------------------------------------------------
FROM ${NODE_IMAGE} AS runtime
WORKDIR /app

ENV NODE_ENV=production \
    AI_FLEET_DATA_DIR=/tmp

COPY --from=builder --chown=node:node /app /app

# Non-root (infra-misconfig checklist).
USER node

# The planner reads process.env.PLANNER_PORT (CONFIG.SERVICES.plannerPort), NOT
# PORT — the Cloud Run service sets PLANNER_PORT=8080 so it binds the port Cloud
# Run health-checks.
EXPOSE 8080

CMD ["node", "services/planner/src/index.js"]
