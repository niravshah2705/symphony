# Copy to deploy/gcp/.env (gitignored) and restrict it to the operator account:
#   cp deploy/gcp/.env.example deploy/gcp/.env
#   chmod 600 deploy/gcp/.env
# The local deploy/skills/registry commands use ambient gcloud/gsutil auth.

# Required for Terraform deployments.
GCP_PROJECT_ID=your-gcp-project
GCP_REGION=asia-south1
SPA_BUCKET=your-gcp-project-aifleet-spa
TF_STATE_BUCKET=your-gcp-project-tfstate
INTERNAL_API_TOKEN=replace-with-a-long-random-value

# Shared deployment defaults.
AR_REPO=ai-fleet
DOCKER_PLATFORM=linux/amd64
TF_STATE_PREFIX=ai-fleet/gcp
GATEWAY_SERVICE_NAME=gateway
FIRESTORE_LOCATION=nam5
SPA_ORIGIN=https://your-gcp-project.web.app
FIREBASE_ALLOWED_DOMAIN=
AUTH_ADMIN_EMAILS=
AUTH_DEFAULT_ROLE=viewer
GOOGLE_ONE_TAP_CLIENT_ID=
SPA_OBFUSCATION_STRENGTH=light

# Versioned GCS publishers.
SKILLS_BUCKET=
SKILLS_VERSION=v1
REGISTRY_BUCKET=aifleet-registry

# Optional services and durable pipeline (fail closed by default).
PROVISIONING_ENABLED=false
PIPELINE_ORCHESTRATOR_ENABLED=false
PIPELINE_DEPLOYMENT_ENABLED=false
SETTINGS_OPERATOR_INVOKER=

# Optional transactional email configuration. Credential values themselves
# remain in Secret Manager; this file carries only the mount/config switches.
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_SECURE=false
EMAIL_SMTP_REQUIRE_TLS=true
EMAIL_SMTP_AUTH_ENABLED=false
EMAIL_FROM=
EMAIL_PUBLIC_APP_URL=https://your-gcp-project.web.app
