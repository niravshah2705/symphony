FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

# CPU-only torch first: the default PyPI wheel bundles CUDA libs that a
# LAYA_DEVICE=cpu container never uses (and that inflate the image by GBs).
RUN pip install --no-cache-dir --upgrade pip \
 && pip install --no-cache-dir --index-url https://download.pytorch.org/whl/cpu torch \
 && pip install --no-cache-dir "laya[serve]"

# CPU inference; checkpoints are NOT baked in — the HF hub cache is mounted
# read-only from GCS (see deploy/gcp/terraform/laya_models.tf + laya_inference.tf).
# LAYA_PRELOAD builds all served checkpoints before listening; device/thread and
# offline-HF env (HF_HUB_CACHE, HF_HUB_OFFLINE) are set in Terraform so they can be
# retuned without a rebuild.
ENV LAYA_DEVICE=cpu \
    LAYA_PRELOAD=1

EXPOSE 8000
CMD ["laya-serve"]
