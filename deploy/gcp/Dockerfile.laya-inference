FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

# CPU-only torch first: the default PyPI wheel bundles CUDA libs that a
# LAYA_DEVICE=cpu container never uses (and that inflate the image by GBs).
RUN pip install --no-cache-dir --upgrade pip \
 && pip install --no-cache-dir --index-url https://download.pytorch.org/whl/cpu torch \
 && pip install --no-cache-dir "laya[serve]"

# Bake the three served checkpoints into a HF hub-style cache at build time.
# Runtime then reads them from the container's own disk: safetensors random
# reads over gcsfuse took ~3.5min per CPU checkpoint build and preloading
# blocks the port bind, which failed every startup-probe window on Cloud Run
# (revisions 00015-00018). Rebuild = re-release: the image digest pins the
# weights, and laya-serve never touches the Hub (HF_HUB_OFFLINE).
RUN pip install --no-cache-dir -U "huggingface_hub[cli]" \
 && hf download convaiinnovations/laya --cache-dir /opt/laya-cache \
 && hf download convaiinnovations/laya-multilingual --cache-dir /opt/laya-cache \
 && hf download convaiinnovations/laya-typed-decisions --cache-dir /opt/laya-cache

# CPU inference; LAYA_PRELOAD builds all served checkpoints before listening.
# Device/thread caps are set in Terraform so they can be retuned per CPU size
# without a rebuild.
ENV LAYA_DEVICE=cpu \
    LAYA_PRELOAD=1 \
    HF_HUB_OFFLINE=1 \
    TRANSFORMERS_OFFLINE=1 \
    HF_HUB_CACHE=/opt/laya-cache

EXPOSE 8000
CMD ["laya-serve"]
