  "cards": [
    {
      "dot": "cyan",
      "title": "Primary Path",
      "items": [
        "Browser requests enter through the Gateway, which owns auth, EULA, billing, SSE, and same-origin API proxying.",
        "Pipeline starts are admitted once, then the Orchestrator emits typed stage commands over Pub/Sub or local HTTP.",
        "Workers execute plan/code/test/deploy stages and persist results before publishing outcomes."
      ]
    },
    {
      "dot": "rose",
      "title": "Trust Boundaries",
      "items": [
        "Agent workers do not receive raw third-party provider credentials in their environment.",
        "With EGRESS_PROXY_URL set, SDK and fetch base URLs point at the sidecar and cannot bypass provider-specific routes.",
        "The proxy strips inbound auth, matches only fixed route prefixes, and injects the resolved credential upstream."
      ]
    },
    {
      "dot": "emerald",
      "title": "Tenant And Secret Control",
      "items": [
        "The Org service validates memberships and selected organization/project context.",
        "The Settings service stores policies and KMS-envelope-encrypted organization/project vault credentials.",
        "The proxy resolves managed or customer credentials through internal S2S endpoints and fails closed on missing required keys."
      ]
    },
    {
      "dot": "amber",
      "title": "External Dependencies",
      "items": [
        "LLM providers include OpenAI/Codex, Anthropic/Claude, Gemini, Hugging Face, local Ollama/LM Studio/OMLX, and optional LangSmith LLM Gateway.",
        "Planning and repository integrations include Linear, Jira, Asana, GitHub, GitLab, and LangSmith tracing.",
        "Cloud runtime depends on Firestore state/checkpoints and authenticated Pub/Sub messaging."
      ]
    }
  ]
