{
  "openapi": "3.0.0",
  "info": {
    "title": "Software Factory Gateway API",
    "description": "Agent-free Software Factory API gateway — browser auth, billing, EULA, SSE, publishing, and authorized reverse proxies.",
    "version": "1.0.0",
    "contact": {
      "name": "Software Factory Team"
    }
  },
  "servers": [
    {
      "url": "http://localhost:4000",
      "description": "Local development server"
    },
    {
      "url": "https://api.aifleet.com",
      "description": "Production server"
    }
  ],
  "paths": {
    "/api/agent/fleet/agents": {
      "get": {
        "tags": ["Fleet"],
        "summary": "List agents",
        "description": "Configured agent profiles for the selected organization and project (platform defaults merged with tenant copies). Requires a valid Firebase bearer plus an organization selection header.",
        "operationId": "fleetListAgents",
        "security": [{ "Bearer": [] }],
        "parameters": [
          { "$ref": "#/components/parameters/OrganizationHeader" },
          { "$ref": "#/components/parameters/ProjectHeader" }
        ],
        "responses": {
          "200": {
            "description": "Agent profiles",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "count": { "type": "integer" },
                    "agents": {
                      "type": "array",
                      "items": { "type": "object", "additionalProperties": true }
                    }
                  }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/OrganizationContextRequired" }
        }
      }
    },
    "/api/agent/fleet/actors": {
      "get": {
        "tags": ["Fleet"],
        "summary": "List running actors",
        "description": "Live substrate (gVisor) actors for the selected organization's namespace, read from the control plane. `projectId` narrows the list by the plan-<project>- actor-name prefix (a display filter, not a scope). Returns configured:false with an empty list when the substrate is not reachable/authenticatable.",
        "operationId": "fleetListActors",
        "security": [{ "Bearer": [] }],
        "parameters": [
          { "$ref": "#/components/parameters/OrganizationHeader" },
          { "$ref": "#/components/parameters/ProjectHeader" },
          { "name": "projectId", "in": "query", "required": false, "description": "Display filter on actor name prefix.", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "Substrate status and actor list",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "configured": { "type": "boolean" },
                    "credentialConfigured": { "type": "boolean" },
                    "atespace": { "type": "string" },
                    "agentPattern": { "type": "string" },
                    "workerPool": { "type": "string" },
                    "ingressUrl": { "type": "string" },
                    "status": { "type": "object", "additionalProperties": true },
                    "contextProjectId": { "type": "string" },
                    "projectFilter": { "type": "object", "nullable": true, "additionalProperties": true },
                    "actors": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "name": { "type": "string" },
                          "state": { "type": "string" },
                          "workerPod": { "type": "string" },
                          "nodeName": { "type": "string" }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/OrganizationContextRequired" }
        }
      }
    },
    "/api/agent/fleet/actors/usage": {
      "get": {
        "tags": ["Fleet"],
        "summary": "List actor usage",
        "description": "Per-actor compute sessions (metering ledger rows) for the selected organization and project.",
        "operationId": "fleetListActorUsage",
        "security": [{ "Bearer": [] }],
        "parameters": [
          { "$ref": "#/components/parameters/OrganizationHeader" },
          { "$ref": "#/components/parameters/ProjectHeader" },
          { "name": "status", "in": "query", "required": false, "description": "Filter sessions by lifecycle status.", "schema": { "type": "string", "enum": ["RUNNING", "CLOSED"] } }
        ],
        "responses": {
          "200": {
            "description": "Actor usage rows and totals",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "actorUsage": {
                      "type": "array",
                      "items": { "type": "object", "additionalProperties": true }
                    },
                    "totals": {
                      "type": "object",
                      "properties": {
                        "sessions": { "type": "integer" },
                        "running": { "type": "integer" },
                        "seconds": { "type": "number" }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/OrganizationContextRequired" }
        }
      }
    },
    "/api/agent/fleet/tokens/usage": {
      "get": {
        "tags": ["Fleet"],
        "summary": "List token usage",
        "description": "Per-run LLM token and credit usage rows for the selected organization and project, newest first.",
        "operationId": "fleetListTokenUsage",
        "security": [{ "Bearer": [] }],
        "parameters": [
          { "$ref": "#/components/parameters/OrganizationHeader" },
          { "$ref": "#/components/parameters/ProjectHeader" },
          { "name": "since", "in": "query", "required": false, "description": "ISO timestamp lower bound on createdAt.", "schema": { "type": "string", "format": "date-time" } },
          { "name": "limit", "in": "query", "required": false, "description": "Maximum number of rows to return.", "schema": { "type": "integer", "minimum": 0 } }
        ],
        "responses": {
          "200": {
            "description": "Token usage rows and totals",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "tokenUsage": {
                      "type": "array",
                      "items": { "type": "object", "additionalProperties": true }
                    },
                    "totals": {
                      "type": "object",
                      "properties": {
                        "inputTokens": { "type": "number" },
                        "outputTokens": { "type": "number" },
                        "totalTokens": { "type": "number" },
                        "costTokenCredits": { "type": "number" },
                        "notionalCostTokenCredits": { "type": "number" },
                        "records": { "type": "integer" }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/OrganizationContextRequired" }
        }
      }
    },
    "/healthz": {
      "get": {
        "summary": "Health check",
        "description": "Returns the health status of the gateway",
        "tags": ["Health"],
        "responses": {
          "200": {
            "description": "Gateway is healthy",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "ok"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/config": {
      "get": {
        "summary": "Get public authentication configuration",
        "description": "Returns Firebase web config for the SPA to initialize authentication",
        "tags": ["Authentication"],
        "responses": {
          "200": {
            "description": "Firebase web configuration",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "apiKey": { "type": "string" },
                    "authDomain": { "type": "string" },
                    "projectId": { "type": "string" },
                    "storageBucket": { "type": "string" },
                    "messagingSenderId": { "type": "string" },
                    "appId": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/me": {
      "get": {
        "summary": "Get authenticated user identity and permissions",
        "description": "Returns the current user's identity, role, and permissions",
        "tags": ["Authentication"],
        "security": [
          { "Bearer": [] }
        ],
        "responses": {
          "200": {
            "description": "User authenticated",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "authenticated": { "type": "boolean" },
                    "user": {
                      "type": "object",
                      "properties": {
                        "sub": { "type": "string" },
                        "email": { "type": "string" },
                        "name": { "type": "string" }
                      }
                    },
                    "role": { "type": "string" },
                    "permissions": {
                      "type": "array",
                      "items": { "type": "string" }
                    },
                    "notificationsEnabled": { "type": "boolean" }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated"
          }
        }
      }
    },
    "/api/config": {
      "get": {
        "summary": "Get deployment configuration",
        "description": "Returns configuration for the current deployment (shared or per-tenant)",
        "tags": ["Configuration"],
        "security": [
          { "Bearer": [] }
        ],
        "responses": {
          "200": {
            "description": "Deployment configuration",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "authenticated": { "type": "boolean" },
                    "gatewayUrl": { "type": "string" },
                    "tenantId": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/agent/stream": {
      "get": {
        "summary": "Server-Sent Events stream for conversation updates",
        "description": "Stream for conversation status, job updates, and coder events",
        "tags": ["Streaming"],
        "parameters": [
          {
            "name": "token",
            "in": "query",
            "required": true,
            "description": "Signed stream token",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Event stream established",
            "content": {
              "text/event-stream": {}
            }
          },
          "401": {
            "description": "Invalid or expired token"
          }
        }
      }
    },
    "/api/agent/workspace-stream": {
      "get": {
        "summary": "Server-Sent Events stream for workspace updates",
        "description": "Stream for workspace-level status and events",
        "tags": ["Streaming"],
        "parameters": [
          {
            "name": "token",
            "in": "query",
            "required": true,
            "description": "Signed workspace stream token",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Workspace event stream established",
            "content": {
              "text/event-stream": {}
            }
          },
          "401": {
            "description": "Invalid or expired token"
          }
        }
      }
    },
    "/api/agent/stream-token": {
      "get": {
        "summary": "Mint a conversation stream token",
        "description": "Create a signed token to establish an SSE connection for a specific conversation",
        "tags": ["Streaming"],
        "security": [
          { "Bearer": [] }
        ],
        "parameters": [
          {
            "name": "conversationId",
            "in": "query",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Stream token minted",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "token": { "type": "string" },
                    "expiresIn": { "type": "number" }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated"
          },
          "404": {
            "description": "Conversation not found"
          }
        }
      }
    },
    "/api/agent/workspace-stream-token": {
      "get": {
        "summary": "Mint a workspace stream token",
        "description": "Create a signed token to establish an SSE connection for workspace updates",
        "tags": ["Streaming"],
        "security": [
          { "Bearer": [] }
        ],
        "responses": {
          "200": {
            "description": "Workspace stream token minted",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "token": { "type": "string" },
                    "expiresIn": { "type": "number" }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated"
          }
        }
      }
    },
    "/api/eula": {
      "get": {
        "summary": "Get EULA acceptance status",
        "description": "Check if the current user has accepted the EULA",
        "tags": ["EULA"],
        "responses": {
          "200": {
            "description": "EULA status",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "accepted": { "type": "boolean" },
                    "acceptedAt": { "type": "string", "format": "date-time" }
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Record EULA acceptance",
        "description": "Mark the EULA as accepted for the authenticated user",
        "tags": ["EULA"],
        "security": [
          { "Bearer": [] }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "accepted": { "type": "boolean" }
                },
                "required": ["accepted"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "EULA acceptance recorded"
          },
          "401": {
            "description": "Not authenticated"
          }
        }
      }
    },
    "/api/billing": {
      "get": {
        "summary": "Get billing information",
        "description": "Retrieve organization billing data and costs",
        "tags": ["Billing"],
        "security": [
          { "Bearer": [] }
        ],
        "responses": {
          "200": {
            "description": "Billing information",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "orgId": { "type": "string" },
                    "totalCost": { "type": "number" },
                    "currency": { "type": "string" },
                    "period": {
                      "type": "object",
                      "properties": {
                        "start": { "type": "string", "format": "date" },
                        "end": { "type": "string", "format": "date" }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated"
          }
        }
      }
    },
    "/api/pipeline/start": {
      "post": {
        "summary": "Start a new pipeline",
        "description": "Initialize a new planner or coder pipeline run",
        "tags": ["Pipeline"],
        "security": [
          { "Bearer": [] }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "enum": ["planner", "coder"]
                  },
                  "model": { "type": "string" },
                  "context": { "type": "object" }
                },
                "required": ["type"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Pipeline started",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "runId": { "type": "string" },
                    "status": { "type": "string" }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated"
          },
          "403": {
            "description": "EULA not accepted"
          }
        }
      }
    },
    "/api/agent/knowledge-search": {
      "post": {
        "summary": "Search knowledge base",
        "description": "RAG search over reviewed repository documentation (public access)",
        "tags": ["Knowledge"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "query": { "type": "string" },
                  "limit": { "type": "integer", "default": 10 }
                },
                "required": ["query"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Search results",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "results": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": { "type": "string" },
                          "title": { "type": "string" },
                          "content": { "type": "string" },
                          "score": { "type": "number" }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/agent/business/prepare": {
      "post": {
        "summary": "Prepare a business context",
        "description": "Run the 6-stage pipeline to prepare a business context",
        "tags": ["Agent"],
        "security": [
          { "Bearer": [] }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "businessId": { "type": "string" },
                  "repositoryUrl": { "type": "string" }
                },
                "required": ["businessId"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Business context prepared",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "businessId": { "type": "string" },
                    "status": { "type": "string" }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated"
          },
          "403": {
            "description": "EULA not accepted"
          }
        }
      }
    },
    "/api/agent/conversations": {
      "get": {
        "summary": "List conversations",
        "description": "Get all conversations for the authenticated user",
        "tags": ["Conversations"],
        "security": [
          { "Bearer": [] }
        ],
        "responses": {
          "200": {
            "description": "List of conversations",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": { "type": "string" },
                      "title": { "type": "string" },
                      "createdAt": { "type": "string", "format": "date-time" },
                      "updatedAt": { "type": "string", "format": "date-time" }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated"
          }
        }
      }
    },
    "/api/org/me": {
      "get": {
        "summary": "Get personal organization context",
        "description": "Retrieve current user's personal workspace and projects",
        "tags": ["Organization"],
        "security": [
          { "Bearer": [] }
        ],
        "responses": {
          "200": {
            "description": "Personal organization data",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "orgId": { "type": "string" },
                    "orgName": { "type": "string" },
                    "role": { "type": "string" }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "Bearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Firebase ID token"
      }
    },
    "parameters": {
      "OrganizationHeader": {
        "name": "x-ai-fleet-organization-id",
        "in": "header",
        "required": true,
        "description": "Selected organization id. Operational fleet routes require it; a missing value is rejected with 403 organization_context_required.",
        "schema": { "type": "string" }
      },
      "ProjectHeader": {
        "name": "x-ai-fleet-project-id",
        "in": "header",
        "required": false,
        "description": "Selected project id. When present, listings are narrowed to this project within the organization.",
        "schema": { "type": "string" }
      }
    },
    "responses": {
      "Unauthorized": {
        "description": "Not authenticated (missing or invalid Firebase bearer token)"
      },
      "OrganizationContextRequired": {
        "description": "No organization selected",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "error": { "type": "string" },
                "code": { "type": "string", "example": "organization_context_required" }
              }
            }
          }
        }
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": { "type": "string" },
          "code": { "type": "string" },
          "details": { "type": "object" }
        }
      },
      "User": {
        "type": "object",
        "properties": {
          "sub": { "type": "string" },
          "email": { "type": "string" },
          "name": { "type": "string" },
          "picture": { "type": "string" }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Health",
      "description": "Service health endpoints"
    },
    {
      "name": "Authentication",
      "description": "User authentication and authorization"
    },
    {
      "name": "Configuration",
      "description": "Deployment and tenant configuration"
    },
    {
      "name": "Streaming",
      "description": "Server-Sent Events (SSE) streams"
    },
    {
      "name": "EULA",
      "description": "End-User License Agreement management"
    },
    {
      "name": "Billing",
      "description": "Organization billing and cost tracking"
    },
    {
      "name": "Pipeline",
      "description": "Pipeline execution and management"
    },
    {
      "name": "Knowledge",
      "description": "Knowledge base and RAG search"
    },
    {
      "name": "Agent",
      "description": "Agent-related operations"
    },
    {
      "name": "Conversations",
      "description": "Conversation management"
    },
    {
      "name": "Organization",
      "description": "Organization and workspace management"
    },
    {
      "name": "Fleet",
      "description": "Organization/project-scoped fleet inventory: agents, running actors, actor usage, token usage"
    }
  ]
}
