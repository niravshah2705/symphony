# ---- Application ----
APP_ENV=local
DEBUG=false

# ---- Firestore ----
# GCP project that owns the Firestore database. Empty -> the in-memory fake
# (local dev / tests). The client also honours FIRESTORE_EMULATOR_HOST.
GCP_PROJECT_ID=
FIRESTORE_DATABASE=(default)
# Collection namespace so this service shares a project's Firestore without
# colliding with the org service (which uses `org_service`).
FIRESTORE_NAMESPACE=settings_service

# ---- Local JWT (self-issued access tokens) ----
# Generate a strong secret, e.g. `openssl rand -hex 32`. NEVER commit the real value.
JWT_SECRET=change-me-in-production-openssl-rand-hex-32
JWT_ISSUER=settings-service
JWT_AUDIENCE=settings-service-api
ACCESS_TOKEN_TTL_MINUTES=15

# ---- External IdP (OIDC/OAuth2) — Firebase ID tokens ----
# When IDP_ENABLED=true, bearer tokens whose `iss` matches IDP_ISSUER are
# validated via JWKS. Point at Firebase with IDP_FIREBASE_PROJECT=<project>.
IDP_ENABLED=false
IDP_ISSUER=
IDP_JWKS_URL=
IDP_AUDIENCE=
IDP_FIREBASE_PROJECT=

# ---- Item universe (plugins are operator-configurable) ----
# Comma-separated plugin ids surfaced in the "plugins" settings domain.
SETTINGS_PLUGINS_CATALOG=security,langsmith-tracing,playwright,ecc

# ---- Rate limiting ----
AUTH_RATE_LIMIT=60/minute
