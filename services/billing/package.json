{
  "name": "@ai-fleet/billing",
  "version": "1.0.0",
  "description": "Dedicated billing, cost-metering, auto-renew, and Cashfree payments microservice.",
  "private": true,
  "main": "src/index.js",
  "scripts": {
    "start": "node --env-file-if-exists=../../.env src/index.js",
    "dev": "node --watch --env-file-if-exists=../../.env src/index.js",
    "test": "node --test",
    "job:recharge": "node --env-file-if-exists=../../.env src/auto-recharge-job.js",
    "job:platform-charge": "node --env-file-if-exists=../../.env src/platform-charge-job.js",
    "job:credit-expiry": "node --env-file-if-exists=../../.env src/credit-expiry-job.js",
    "job:reconcile": "node --env-file-if-exists=../../.env src/reconcile-gateway-spend.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@ai-fleet/shared-core": "*",
    "express": "^5.2.1"
  }
}
