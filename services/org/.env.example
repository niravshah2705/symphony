# ---- Application ----
APP_ENV=local
DEBUG=false

# ---- Database ----
# Async PostgreSQL DSN. Local docker-compose default shown below.
DATABASE_URL=postgresql+asyncpg://org:org@localhost:5432/orgdb

# ---- Local JWT (self-issued access/refresh tokens) ----
# Generate a strong secret, e.g. `openssl rand -hex 32`. NEVER commit the real value.
JWT_SECRET=change-me-in-production-openssl-rand-hex-32
JWT_ISSUER=org-service
JWT_AUDIENCE=org-service-api
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=14
EMAIL_VERIFICATION_TTL_MINUTES=60
INVITATION_TTL_DAYS=7
# Optional Pub/Sub topic consumed by the email service. Empty = no-op locally.
EMAIL_TOPIC=

# ---- External IdP (OIDC/OAuth2) — optional hybrid auth ----
# When IDP_ENABLED=true, bearer tokens whose `iss` matches IDP_ISSUER are validated via JWKS.
IDP_ENABLED=false
IDP_ISSUER=
IDP_JWKS_URL=
IDP_AUDIENCE=

# ---- Platform super-admin bootstrap ----
# Seeded at startup if no super-admin exists. Leave blank to skip seeding.
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=

# ---- Rate limiting ----
AUTH_RATE_LIMIT=10/minute
