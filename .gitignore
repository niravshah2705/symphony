# Dependencies
node_modules/

# Build/release artifacts (e.g. the adlc CLI bundle + tarball; produced in CI).
dist/

# Generated www marketing tree — scripts/build-marketing-site.js promotes
# public/adlc/** to the site root. Rebuilt by deploy-www.yml before each release.
marketing/

# Local runtime data — secrets (API keys, OAuth tokens), config, jobs, logs.
# Never commit; see docs/DEVELOPER_ONBOARDING.md.
data/

# Environment / secrets — kept locally for the next run, never pushed.
.env
.env.*
!.env.example

# adlc CLI stored token (normally in $HOME/.adlc; ignored here in case
# $ADLC_HOME ever points into the repo). Never commit credentials.
.adlc/

# OS / editor cruft
.DS_Store
*.log

# Playwright browser-test artifacts
playwright-report/
test-results/
# Browser storage states contain live session cookies and bearer material.
.playwright-auth/

# Terraform — provider binaries and state (the .terraform.lock.hcl IS committed).
**/.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example

# AI/dev tooling & local artifacts — ephemeral, never committed.
.claude/worktrees/
.playwright-mcp/
graphify-out/
agent-layout.png
# Harness-registry build output — built in CI and published to GCS, never committed
# (may contain third-party plugin payloads). The sources.json + converter code IS committed.
registry-bundle-out/
registry-bundle/
# Added by code-review-graph
.code-review-graph/
.agent/skills/cashfree-skills/
.claude/skills/
.agents/skills/cashfree-skills/
.kiro/skills/
.opencode/skills/cashfree-skills/

# substrate-cleanup.sh snapshot mirror (cluster config; never commit)
.substrate-state/

# FlexPrice spike output: re-written on every run, and its ids/amounts are run
# fixtures. docs/FLEXPRICE_FINDINGS.md is the graded record of what was observed.
docs/flexprice-spike/results.json

# The kind Helm install stages a copy of the pinned upstream chart here with its
# subchart dependencies stripped (scripts/flexprice-helm.js). Derived from the
# checkout on every run; committing it would fork 2000 lines of AGPL templates.
deploy/flexprice/helm/build/
docs/code-graph/

# kagent plugin/skill artifact build scratch: the fetched upstream checkout at the
# pinned commit, the composed bundle/ that becomes the docker context, the stamped
# *.local.yaml, and the oci-ref files. Every pack regenerates it from its CSV row:
# deploy/kagent/build-plugin-image.sh <plugin>, deploy/kagent/build-skill-image.sh <skill>
deploy/kagent/*/build/
deploy/kagent/skills/*/build/

# Python bytecode caches. Nothing in this repo should ship them; the one that
# slipped in was committed before this rule existed.
__pycache__/
*.pyc

# Hallmark design-run output: the dealt-theme log, pre-flight cache, before/
# snapshots and the sloplint render screenshots, ~70 MB across the marketing
# routes. Local review artifacts; the committed record is the stamp in each
# stylesheet's first 40 lines.
.hallmark/
