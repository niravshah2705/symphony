# Dependencies
node_modules/

# Local runtime data — secrets (API keys, OAuth tokens), config, jobs, logs.
# Never commit; see docs/DEVELOPER_ONBOARDING.md.
data/

# Environment / secrets — kept locally for the next run, never pushed.
.env
.env.*
!.env.example

# OS / editor cruft
.DS_Store
*.log

# Playwright browser-test artifacts
playwright-report/
test-results/

# Terraform — provider binaries and state (the .terraform.lock.hcl IS committed).
**/.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
