# Dependencies
node_modules/

# Build/release artifacts (e.g. the adlc CLI bundle + tarball; produced in CI).
dist/

# Local runtime data — secrets (API keys, OAuth tokens), config, jobs, logs.
# Never commit; see docs/DEVELOPER_ONBOARDING.md.
data/

# Environment / secrets — kept locally for the next run, never pushed.
.env
.env.*
!.env.example

# adlc CLI stored token (normally in $HOME/.adlc; ignored here in case
# $ADLC_HOME ever points into the repo). Never commit credentials.
.adlc/

# OS / editor cruft
.DS_Store
*.log

# Playwright browser-test artifacts
playwright-report/
test-results/

# Terraform — provider binaries and state (the .terraform.lock.hcl IS committed).
**/.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example

# AI/dev tooling & local artifacts — ephemeral, never committed.
.claude/worktrees/
.playwright-mcp/
graphify-out/
agent-layout.png
# Added by code-review-graph
.code-review-graph/
